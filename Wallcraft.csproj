<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon Condition="'$(ApplicationIcon)' == ''">Assets\Wallcraft.ico</ApplicationIcon>
    <RePkgRuntimeDirectory Condition="'$(RePkgRuntimeDirectory)' == ''">RePKG\repkg-ng\release</RePkgRuntimeDirectory>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath Condition="'$(Configuration)' == 'Release'">Release\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="MainForm.cs" />
    <Compile Include="SteamPaths.cs" />
    <Content Include="$(RePkgRuntimeDirectory)\**\*">
      <Link>repkg-ng\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="CreatePortableEntryPoint" AfterTargets="Publish" Condition="'$(PortableRootPath)' != ''">
    <CreateAppHost AppHostSourcePath="$(AppHostSourcePath)"
                   AppHostDestinationPath="$(PortableRootPath)\Wallcraft.exe"
                   AppBinaryName="app/Wallcraft.dll"
                   IntermediateAssembly="@(IntermediateAssembly->'%(FullPath)')"
                   WindowsGraphicalUserInterface="true" />
  </Target>
</Project>
